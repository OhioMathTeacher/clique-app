#!/bin/sh
set -eu
# Re-measure the About panel so its numbers always describe this commit.
# Enable once per clone:  git config core.hooksPath .githooks
command -v node >/dev/null 2>&1 || { echo "measure: node not found, skipping"; exit 0; }
node "$(git rev-parse --show-toplevel)/measure.mjs" || exit 1
git add "$(git rev-parse --show-toplevel)/index.html"
